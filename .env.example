# Local dev normally uses the single workspace .env one folder up (../.env).
# Local: call the API directly.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Vercel (production): set NEXT_PUBLIC_API_URL to an empty value and BACKEND_URL to the API.
# The browser then calls /api/* on the web domain, proxied to BACKEND_URL (first-party cookies).
# NEXT_PUBLIC_API_URL=
# BACKEND_URL=https://your-api.vercel.app

# Show demo account buttons on the login page (never in production).
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
NEXT_PUBLIC_ENABLE_DEMO_RESET=false
